SERPAPI_API_KEY=
# Google Maps (Free) sidecar — 0 = band, 1 = on (default on)
GMAPS_ENABLE=1
# Razorpay (https://razorpay.com -> Settings -> API Keys). Test keys se shuru karo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
LF_CALLBACK_URL=http://localhost:8501
# Admin login (sirf tumhare liye — API keys/status sirf admin dekhega)
ADMIN_USER=admin
ADMIN_PASS=admin123
